{
  "name": "qux",
  "version": "1.0.0",
  "description": "Telegram bot for posting and moderating ads",
  "private": true,
  "main": "src/bot.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node src/bot.js",
    "dev": "cross-env NODE_ENV=development nodemon --watch src src/bot.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "ioredis": "^5.6.1",
    "mongoose": "^8.17.0",
    "nanoid": "^5.0.7",
    "pino": "^9.7.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "pino-pretty": "^11.2.2"
  }
}
